# INERT TEMPLATE: needs separate owner approval and secret/retention review.
# Scheduled execution from a non-default branch needs a separately approved scheduler.
# Requires pg_dump >= source server major, private key custody and restore drill.
name: AB Group approved staging encrypted backup
on:
  push:
    branches: [staging/ab-group-test]
  workflow_dispatch:
permissions:
  contents: read
jobs:
  backup:
    if: github.ref == 'refs/heads/staging/ab-group-test' && vars.STAGING_BACKUP_ENABLED == 'true'
    environment: supabase-test
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09
        with:
          persist-credentials: false
      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444
        with:
          node-version: '24'
      - run: npm ci --ignore-scripts --omit=optional --no-audit --no-fund
      - run: node backend/deploy/build.mjs
      - name: Install compatible PostgreSQL dump client (no database server)
        run: sudo apt-get update && sudo apt-get install -y postgresql-client-17
      - name: Capture encrypted read-only source backup without plaintext files
        env:
          AB_BACKUP_APPROVED: 'yes'
          NODE_EXTRA_CA_CERTS: ${{ github.workspace }}/backend/certificates/supabase-prod-ca-2021.crt
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_PUBLISHABLE_KEY: ${{ secrets.SUPABASE_PUBLISHABLE_KEY }}
          SUPABASE_SECRET_KEY: ${{ secrets.SUPABASE_SECRET_KEY }}
          MIGRATION_DATABASE_URL: ${{ secrets.MIGRATION_DATABASE_URL }}
          DATA_ENCRYPTION_KEY: ${{ secrets.DATA_ENCRYPTION_KEY }}
          BACKUP_ENCRYPTION_KEY: ${{ secrets.BACKUP_ENCRYPTION_KEY }}
        run: node backend-build/deploy/backup-staging.js
      # Encrypted archives only. Do not upload work/, .env, logs, raw dumps or keys.
      # Add a pinned official upload-artifact action ONLY after storage approval.
      # Daily retention: 7 days; weekly copy: 35 days; no plaintext artifacts.
