# REVIEW ONLY: install/enable this manual workflow only after separate owner approval.
# No push/schedule trigger; no deploy hook, new connection secret or automatic database reset.
name: Owner-confirmed original staging database reset
on:
  workflow_dispatch:
    inputs:
      mode:
        type: choice
        required: true
        options: [preview, execute, recover]
      request_id:
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: ab-controlled-staging-refs/heads/staging/ab-group-test
  cancel-in-progress: false
jobs:
  reset:
    if: github.repository == 'dubai717/ab-group-demo' && github.ref == 'refs/heads/staging/ab-group-test'
    runs-on: ubuntu-latest
    environment: supabase-test
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09
        with:
          persist-credentials: false
          ref: ${{ github.sha }}
      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444
        with:
          node-version: '24'
      - run: npm ci --ignore-scripts --no-audit --no-fund
      - run: node node_modules/typescript-portable/bin/tsc -p backend/tsconfig.json
      - name: Isolated restore target, never the cloud
        run: |
          set -euo pipefail
          docker run --detach --name ab-backup-drill-postgres --publish 127.0.0.1:5547:5432 --tmpfs /var/lib/postgresql/data:rw,nosuid,nodev,size=1g -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_DB=ab_drill postgres:17 > /dev/null
          docker cp backend/certificates/supabase-prod-ca-2021.crt ab-backup-drill-postgres:/tmp/ab-ca.crt
          for i in $(seq 1 60); do
            if docker exec ab-backup-drill-postgres pg_isready -U postgres -d ab_drill > /dev/null; then exit 0; fi
            sleep 1
          done
          exit 1
      - name: Owner-approved request only (unarmed by default)
        env:
          APP_ENV: staging
          RESET_RECOVERY_APPROVAL: ${{ vars.RESET_RECOVERY_APPROVAL }}
          RESET_MODE: ${{ inputs.mode }}
          RESET_REQUEST_ID: ${{ inputs.request_id }}
          RESET_EXECUTION_ARMED: ${{ vars.RESET_EXECUTION_ARMED }}
          AB_BACKUP_DRILL_APPROVED: read-only-source-isolated-restore
          AB_BACKUP_RETAIN_APPROVED: private-bucket-no-overwrite
          AB_STAGING_AUTOMATION: controlled-test-only
          NODE_EXTRA_CA_CERTS: ${{ github.workspace }}/backend/certificates/supabase-prod-ca-2021.crt
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_PUBLISHABLE_KEY: ${{ secrets.SUPABASE_PUBLISHABLE_KEY }}
          SUPABASE_SECRET_KEY: ${{ secrets.SUPABASE_SECRET_KEY }}
          MIGRATION_DATABASE_URL: ${{ secrets.MIGRATION_DATABASE_URL }}
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
          DATA_ENCRYPTION_KEY: ${{ secrets.DATA_ENCRYPTION_KEY }}
          BACKUP_ENCRYPTION_KEY: ${{ secrets.BACKUP_ENCRYPTION_KEY }}
        run: node --import tsx backend/reset/admin-worker.ts
      - if: always()
        run: docker rm --force --volumes ab-backup-drill-postgres > /dev/null 2>&1 || true
