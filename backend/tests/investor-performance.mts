import {businessCentersFixture} from './business-centers-fixture.js';
import {readFile,writeFile} from 'node:fs/promises';
const f=await businessCentersFixture();let count=0;
f.runtime.on('acquire',(client:any)=>{if(client._measured)return;client._measured=true;const original=client.query.bind(client);client.query=(...args:any[])=>{count++;return original(...args);};});
try{await f.admin.query(await readFile('supabase/additive/026_investor_registry_versions.sql','utf8'));await f.admin.query(await readFile('supabase/additive/027_investor_electronic_access.sql','utf8'));
let profile='';for(let i=0;i<100;i++){const p=await f.req('POST','/api/investor-registry/profiles',{nameAr:'مستثمر قياس '+i,nameEn:'Benchmark investor '+i,type:'individual',identityNumber:'PERF-'+i,identityAuthority:'Synthetic',nationality:'AE',phone:'+971500000000',address:'Isolated'});profile=p.id;}
const pdf=Buffer.from('%PDF-1.4 synthetic benchmark'),versions=[];for(let i=0;i<8;i++){const d=await f.req('POST','/api/documents',{userId:f.org.user,investorProfileId:profile,category:'contract',title:'Perf '+i,date:f.date,name:'perf-'+i+'.pdf',mime:'application/pdf',base64:Buffer.concat([pdf,Buffer.from(String(i))]).toString('base64')});versions.push(d.versionId);await f.req('POST','/api/investor-registry/profiles/'+profile+'/documents',{versionId:d.versionId,kind:'other',classification:'other'});}
const results:any={fixture:'100 synthetic investors, 8 private documents, 7 sequential warm samples; local isolated PostgreSQL, HTTP injection; excludes internet latency',metrics:{}};
for(const [name,url]of Object.entries({dashboard:'/api/central-dashboard',register:'/api/investor-registry/profiles',profile:'/api/investor-registry/profiles/'+profile})){await f.req('GET',url);const times=[],queries=[];for(let i=0;i<7;i++){count=0;const start=performance.now();await f.req('GET',url);times.push(performance.now()-start);queries.push(count);}times.sort((a,b)=>a-b);results.metrics[name]={medianMs:+times[3].toFixed(2),p95Ms:+times[6].toFixed(2),queries:queries[3]};}
count=0;const start=performance.now();const doc=await f.req('POST','/api/documents',{userId:f.org.user,investorProfileId:profile,category:'contract',title:'Upload benchmark',date:f.date,name:'upload-benchmark.pdf',mime:'application/pdf',base64:Buffer.concat([pdf,Buffer.from('uploaded')]).toString('base64')});await f.req('POST','/api/investor-registry/profiles/'+profile+'/documents',{versionId:doc.versionId,kind:'other',classification:'other'});results.metrics.uploadAndLink={ms:+(performance.now()-start).toFixed(2),queries:count,bytes:pdf.length+8};
await writeFile('work/investor-performance-'+(process.argv[2]||'sample')+'.json',JSON.stringify(results,null,2));console.log(JSON.stringify(results));
}finally{await f.close();}
