// Same isolated fixture and benchmark source may be run from either reviewed AB checkout.
import {execFileSync} from 'node:child_process';
import {pathToFileURL} from 'node:url';
import {resolve} from 'node:path';
import {readFile,writeFile} from 'node:fs/promises';
import {randomUUID} from 'node:crypto';
import {PDFDocument} from 'pdf-lib';
if(execFileSync('git',['remote','get-url','origin'],{encoding:'utf8'}).trim()!=='https://github.com/dubai717/ab-group-demo.git')throw Error('STOP_REPOSITORY_SCOPE_MISMATCH');
const {businessCentersFixture}=await import(pathToFileURL(resolve('backend/tests/business-centers-fixture.ts')).href),f=await businessCentersFixture();let count=0;f.runtime.on('acquire',(c:any)=>{if(c._bench)return;c._bench=true;const query=c.query.bind(c);c.query=(...args:any[])=>{count++;return query(...args);};});
try{for(const name of ['026_investor_registry_versions.sql','027_investor_electronic_access.sql'])await f.admin.query(await readFile('supabase/additive/'+name,'utf8'));
let profile='';for(let n=0;n<100;n++)profile=(await f.req('POST','/api/investor-registry/profiles',{nameAr:'مستثمر قياس معزول '+n,nameEn:'Synthetic benchmark investor '+n,type:'individual',identityNumber:'SYN-BENCH-'+n,identityAuthority:'Synthetic',nationality:'AE',phone:'000',address:'Isolated'})).id;
for(let n=0;n<12;n++){const bban='033'+String(n+7000).padStart(16,'0'),iban='AE'+String(98n-BigInt(bban+'101400')%97n).padStart(2,'0')+bban,co=n%2?f.co1:f.co2,b=await f.req('POST','/api/bank-accounts',{companyId:co,bankId:'demo-bank',branch:'Synthetic',accountName:'Synthetic bank '+n,accountNumber:randomUUID(),iban,swift:'',openedAt:'2025-01-01',status:'Active',purposeId:'operations',openingBalance:'0',currency:'AED',notes:''});await f.req('POST','/api/ledger/accounts',{code:'benchbank'+n,nameAr:'بنك قياس معزول',nameEn:'Synthetic bank',kind:'asset',companyIds:[co],currency:'AED',bankAccountId:b.id});}
const pdf=await PDFDocument.create();pdf.addPage().drawText('Isolated AB Group benchmark');const bytes=Buffer.from(await pdf.save());let version='';for(let n=0;n<8;n++){version=(await f.req('POST','/api/documents',{userId:f.org.user,investorProfileId:profile,category:'contract',title:'Synthetic benchmark '+n,date:f.date,name:'benchmark-'+n+'.pdf',mime:'application/pdf',base64:Buffer.concat([bytes,Buffer.from('\n% '+n)]).toString('base64')})).versionId;await f.req('POST','/api/investor-registry/profiles/'+profile+'/documents',{versionId:version,kind:'other',classification:'other'});}
await f.bill('100');const employee=await f.employee(),login=await f.app.inject({method:'POST',url:'/api/login',payload:{username:f.username,password:f.password},headers:{origin:'http://127.0.0.1:3100','x-ab-request':'1'}});if(login.statusCode!==200)throw Error('synthetic login');const cookie=String(login.headers['set-cookie']).split(';')[0];
const jobs:any={dashboard:()=>f.req('GET','/api/central-dashboard'),drilldown:()=>f.req('GET','/api/central-dashboard?source=customers'),investorRegister:()=>f.req('GET','/api/investor-registry/profiles'),investorProfile:()=>f.req('GET','/api/investor-registry/profiles/'+profile),customerProfile:()=>f.req('GET','/api/customers/'+f.client),permissions:()=>f.req('GET','/api/users/'+employee.id+'/permission-summary'),financialReport:()=>f.req('POST','/api/central-reports/preview',{source:'invoices',columns:['number','amount','currency'],groupBy:['currency'],aggregate:'sum',measure:'amount'}),privatePDF:async()=>{const r=await f.app.inject({method:'GET',url:'/api/documents/'+version+'/file',headers:{cookie}});if(r.statusCode!==200||!r.rawPayload.subarray(0,4).equals(Buffer.from('%PDF')))throw Error('private PDF retrieval');}};
const result:any={fixture:'100 synthetic investors; 12 banks split across 2 companies; 8 genuine private PDF files; 7 warm local HTTP-injection samples; includes auth/RLS, excludes internet',metrics:{}};
for(const [name,fn]of Object.entries(jobs)as any){await fn();const ms:number[]=[],qs:number[]=[];for(let n=0;n<7;n++){count=0;const begin=performance.now();await fn();ms.push(performance.now()-begin);qs.push(count);}ms.sort((a,b)=>a-b);result.metrics[name]={medianMs:+ms[3].toFixed(2),p95Ms:+ms[6].toFixed(2),queries:qs[3]};}
await writeFile('work/dashboard-performance-'+(process.argv[2]||'sample')+'.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result));
}finally{await f.close();}
