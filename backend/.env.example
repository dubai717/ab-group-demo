# Configure locally in a secret file; never commit credentials. No cloud resources are auto-created.
APP_ENV=local
PUBLIC_ORIGIN=http://127.0.0.1:3100
PORT=3100
# PostgreSQL runtime role: ab_runtime, never postgres/owner/service-role.
DATABASE_URL=
# Separate administrator connection; migrations/explicit bootstrap only.
MIGRATION_DATABASE_URL=
# Generate 32 random bytes encoded as base64; keep a versioned, protected backup of this key separately.
DATA_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only, used only for test-account enrollment and authorized encrypted object operations.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ab-private-test
# Independent key for encrypted backup archives, retained separately from DATA_ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=
# Optional trusted scanner worker; without it all actual uploads remain pending/quarantined.
SCANNER_DATABASE_URL=
SCANNER_URL=
SCANNER_TOKEN=
# Explicit provisioning of a NEW synthetic group, after an Auth test subject already exists.
BOOTSTRAP_AUTH_ID=
BOOTSTRAP_EMAIL=
BOOTSTRAP_USERNAME=
BOOTSTRAP_NAME=
